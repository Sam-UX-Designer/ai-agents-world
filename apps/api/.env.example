# API
PORT=4000

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents_world

# Claude. Never ship a key to any client - agents run server-side only.
ANTHROPIC_API_KEY=

# Encryption key for integration tokens at rest (32 bytes, base64).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback
