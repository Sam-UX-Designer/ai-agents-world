# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env - it is gitignored for a reason.
# Every value here is a secret except PORT and APP_URL.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents_world

# Claude. Server-side only - this key must never reach a browser or phone.
ANTHROPIC_API_KEY=

# Encrypts integration tokens at rest. Any random string of 24+ characters;
# your host's "generate a value" button is fine. A 32-byte base64 key
# (openssl rand -base64 32) is used directly if you prefer one.
TOKEN_ENCRYPTION_KEY=

# Signs session cookies. At least 32 characters.
#   openssl rand -base64 48
SESSION_SECRET=

# Google OAuth - Gmail and Calendar.
# Scopes are restricted and need Google's verification review before you can
# use them with accounts outside your test list. Start that review early.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Apple sign-in. All four together or none - Apple's "client secret" is a JWT
# this server signs with your .p8 key, not a static string. From the Apple
# Developer portal (a paid account is required).
#   APPLE_CLIENT_ID   your Services ID, e.g. com.yourcompany.agentsworld.web
#   APPLE_PRIVATE_KEY the .p8 file's contents, newlines written as \n
# Redirect URL to register with Apple:
#   https://<your-api-host>/auth/apple/signin-callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Microsoft OAuth - no longer offered on the sign-in screen, kept for the
# Teams connector.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# ElevenLabs, for agent speech. Optional: without it agents reply in text only
# and everything else still works.
ELEVENLABS_API_KEY=
